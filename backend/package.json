{
  "name": "@reachinbox-scheduler/backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "npm run db:generate && tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src scripts prisma.config.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "loadtest": "ts-node scripts/loadtest.ts",
    "search:reindex": "ts-node scripts/reindex-emails.ts"
  },
  "dependencies": {
    "@bull-board/api": "^8.0.0",
    "@bull-board/express": "^8.0.0",
    "@elastic/elasticsearch": "^8.19.0",
    "@prisma/client": "6.19.3",
    "bullmq": "^5.65.0",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "google-auth-library": "^10.0.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.1",
    "pino": "^10.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prisma": "6.19.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
